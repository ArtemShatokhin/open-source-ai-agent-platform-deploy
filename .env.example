# Kortix self-host — example environment
#
# `kortix self-host init` writes the real .env into the instance directory
# (~/.config/kortix/self-host/<instance>/). Set individual values with
# `kortix self-host env set NAME=value`, or copy this file there for reference.
# Never commit a filled .env — it holds every secret and signing key the
# instance uses.

# Public hostname and the API hostname. Both need an A/AAAA record pointing at
# the box; the bundled Caddy proxy uses ports 80 and 443 for the TLS cert.
KORTIX_DOMAIN=kortix.example.com
KORTIX_API_DOMAIN=api.kortix.example.com

# ACME contact address for the TLS certificate.
KORTIX_ACME_EMAIL=ops@example.com

# Image channel the stack tracks (stable | latest) and the in-compose updater.
KORTIX_SELFHOST_CHANNEL=stable
KORTIX_SELFHOST_AUTO_UPDATE=on
KORTIX_SELFHOST_UPDATE_INTERVAL=86400

# Self-host instance name (data lives under ~/.config/kortix/self-host/<instance>/).
KORTIX_SELFHOST_INSTANCE=default

# Per-container API memory limit. 640m is the default and is right for an 8 GiB
# host; raise to 1024m on a 16 GiB host when API traffic reaches the limit.
KORTIX_API_MEMORY_LIMIT=640m

# Agent sandbox provider (Daytona is the default; Platinum and E2B are also
# supported). Sessions run on this provider, not on the self-host stack.
DAYTONA_API_KEY=

# Managed-git token and owner so agent sessions can push their branch and open
# change requests against the company repo.
MANAGED_GIT_GITHUB_TOKEN=
MANAGED_GIT_GITHUB_OWNER=
